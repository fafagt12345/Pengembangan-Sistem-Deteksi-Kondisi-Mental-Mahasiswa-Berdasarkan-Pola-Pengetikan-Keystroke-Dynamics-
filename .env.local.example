# Copy this file to `.env.local` and fill in the values before running the app.
# Do NOT commit your real `.env.local` to version control.

# Firebase (web app) config - fill from Firebase Console > Project settings > SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Cloudinary (optional) - used for image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_PRESET=your_upload_preset

# Local dev server port (optional)
NEXT_PUBLIC_PORT=3001

# Notes:
# 1) In the Firebase Console: Authentication -> Sign-in method -> enable Google provider.
# 2) In Firebase Console: Authentication -> Settings -> Authorized domains -> add http://localhost:3001 (or your dev URL).
# 3) If you don't use Cloudinary, leave the Cloudinary variables blank; the app will use a UI Avatars fallback.
# 4) After filling `.env.local`, restart the dev server: `npm run dev`.
